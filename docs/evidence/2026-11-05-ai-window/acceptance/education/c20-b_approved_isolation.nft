table inet minifw { # handle 84
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.87 timeout 15m expires 14m41s444ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 415 bytes 24900 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 14 bytes 840 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
