table inet minifw { # handle 83
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 5855 bytes 350940 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 2132 bytes 126920 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
