table inet minifw { # handle 81
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 3536 bytes 212040 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 1207 bytes 71880 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
