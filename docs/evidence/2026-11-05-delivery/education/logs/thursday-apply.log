$ dpkg-query -W minifw-ai
minifw-ai	2.2.10-education
$ ip -j netns list
[]
$ systemctl stop minifw-ai minifw-ai-web dnsmasq
$ nft -a list table inet minifw
table inet minifw { # handle 71
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.99 timeout 1m30s expires 27s720ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 79 bytes 4740 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 0 bytes 0 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
$ nft delete table inet minifw
$ modprobe nf_conntrack
$ sysctl -w net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 net.netfilter.nf_conntrack_acct=0
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.netfilter.nf_conntrack_acct = 0
$ ip netns add mf-client
$ ip -n mf-client link set lo up
$ ip netns add mf-server
$ ip -n mf-server link set lo up
$ ip link add mfcg type veth peer name mfc0
$ ip link set mfc0 netns mf-client
$ ip addr add 10.10.0.1/24 dev mfcg
$ ip addr add fd42:10::1/64 dev mfcg
$ ip link set mfcg up
$ ip -n mf-client addr add 10.10.0.20/24 dev mfc0
$ ip -n mf-client addr add fd42:10::20/64 dev mfc0
$ ip -n mf-client link set mfc0 up
$ ip -n mf-client route add default via 10.10.0.1
$ ip -n mf-client -6 route add default via fd42:10::1
$ ip link add mfsg type veth peer name mfs0
$ ip link set mfs0 netns mf-server
$ ip addr add 198.18.0.1/24 dev mfsg
$ ip addr add fd42:18::1/64 dev mfsg
$ ip link set mfsg up
$ ip -n mf-server addr add 198.18.0.2/24 dev mfs0
$ ip -n mf-server addr add fd42:18::2/64 dev mfs0
$ ip -n mf-server link set mfs0 up
$ ip -n mf-server route add default via 198.18.0.1
$ ip -n mf-server -6 route add default via fd42:18::1
