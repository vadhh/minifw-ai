table inet minifw { # handle 70
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 259 bytes 15540 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 77 bytes 4200 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
