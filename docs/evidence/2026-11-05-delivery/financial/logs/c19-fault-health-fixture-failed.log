$ systemctl stop minifw-ai minifw-ai-web dnsmasq
$ nft -a list table inet minifw
table inet minifw { # handle 67
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 258 bytes 15480 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 92 bytes 4980 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
$ nft delete table inet minifw
