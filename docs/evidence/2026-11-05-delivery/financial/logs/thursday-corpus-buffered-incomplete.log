$ dpkg-query -W minifw-ai
minifw-ai	2.2.10-finance
$ ip -j netns list
[]
$ systemctl stop minifw-ai minifw-ai-web dnsmasq
$ nft -a list table inet minifw
table inet minifw { # handle 62
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 71 bytes 4196 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 72 bytes 3840 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
$ nft delete table inet minifw
$ modprobe nf_conntrack
$ sysctl -w net.ipv4.ip_forward=1 net.ipv6.conf.all.forwarding=1 net.netfilter.nf_conntrack_acct=0
