$ ip addr add 10.10.0.1/24 dev mfcg
$ ip addr add fd42:10::1/64 dev mfcg
$ ip link set mfcg up
$ ip -n mf-client addr add 10.10.0.20/24 dev mfc0
$ ip -n mf-client addr add fd42:10::20/64 dev mfc0
$ ip -n mf-client link set mfc0 up
$ ip -n mf-client route add default via 10.10.0.1
$ ip -n mf-client -6 route add default via fd42:10::1
