$ nft -a list table inet minifw
table inet minifw { # handle 5
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 42 bytes 2977 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 13 bytes 1600 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
