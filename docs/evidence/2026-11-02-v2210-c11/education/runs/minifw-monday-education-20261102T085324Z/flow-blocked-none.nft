table inet minifw { # handle 26
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.20 timeout 15s expires 14s912ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 52 bytes 3155 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 8 bytes 480 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
