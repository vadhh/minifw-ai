table inet minifw_egress { # handle 27
	chain dns { # handle 1
		type nat hook prerouting priority dstnat; policy accept;
		iifname "mfcg" meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 counter packets 1 bytes 76 redirect to :53 # handle 4
	}

	chain forward { # handle 2
		type filter hook forward priority filter - 5; policy accept;
		iifname "mfcg" tcp dport 853 counter packets 2 bytes 120 drop # handle 5
		iifname "mfcg" udp dport 853 counter packets 0 bytes 0 drop # handle 6
		iifname "mfcg" meta nfproto ipv6 counter packets 2 bytes 160 drop # handle 7
	}
}
