table inet minifw { # handle 36
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 235 bytes 71848 comment "MiniFW-AI-Conntrack" # handle 5
		ip saddr @minifw_block_v4 counter packets 149 bytes 49252 drop comment "MiniFW-AI-Blocklist" # handle 6
	}
}
