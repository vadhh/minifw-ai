table inet minifw { # handle 40
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.20 timeout 15s expires 14s452ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 67 bytes 3956 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 68 bytes 3600 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
