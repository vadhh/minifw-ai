table inet minifw { # handle 3
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 198.18.0.2 timeout 15s expires 14s472ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 67 bytes 3956 comment "MiniFW-AI-Conntrack" # handle 5
		ip saddr @minifw_block_v4 counter packets 53 bytes 2820 drop comment "MiniFW-AI-Blocklist" # handle 6
	}
}
