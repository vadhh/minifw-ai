table inet minifw { # handle 3
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 218 bytes 11816 comment "MiniFW-AI-Conntrack" # handle 5
		ip saddr @minifw_block_v4 counter packets 118 bytes 6240 drop comment "MiniFW-AI-Blocklist" # handle 6
	}
}
