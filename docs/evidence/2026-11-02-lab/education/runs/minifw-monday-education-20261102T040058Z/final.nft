table inet minifw { # handle 3
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 198.18.0.2 timeout 15s expires 1s592ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 85 bytes 4895 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 75 bytes 4020 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
