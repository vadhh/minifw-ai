table inet minifw { # handle 73
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.20 timeout 15s expires 14s308ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 128 bytes 7560 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 118 bytes 6360 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
