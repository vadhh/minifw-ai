--- c19src/testing/test_ai_enforcement_switch.py	1970-01-01 07:00:00
+++ switch/testing/test_ai_enforcement_switch.py	2026-11-05 09:44:20
@@ -0,0 +1,59 @@
+"""Packet-model enforcement stays off unless root config approves the exact loaded model file."""
+import hashlib
+from pathlib import Path
+from types import SimpleNamespace
+
+from minifw_ai import main
+from minifw_ai.policy import Policy
+from minifw_ai.utils import mlp_engine
+
+ROOT = Path(__file__).resolve().parents[1]
+HASH = "ab" * 32
+
+
+def test_packet_model_enforces_only_with_matching_approval(monkeypatch):
+    packet = SimpleNamespace(feature_schema="packet14-v1", model_sha256=HASH)
+    monkeypatch.delenv("MINIFW_AI_ENFORCE_MODEL_SHA256", raising=False)
+    assert not main.mlp_may_enforce(packet)
+    monkeypatch.setenv("MINIFW_AI_ENFORCE_MODEL_SHA256", "cd" * 32)
+    assert not main.mlp_may_enforce(packet)
+    monkeypatch.setenv("MINIFW_AI_ENFORCE_MODEL_SHA256", f" {HASH.upper()}\n")
+    assert main.mlp_may_enforce(packet)
+    # An approval never matches a detector whose load failed (empty hash).
+    monkeypatch.setenv("MINIFW_AI_ENFORCE_MODEL_SHA256", "")
+    assert not main.mlp_may_enforce(SimpleNamespace(feature_schema="packet14-v1", model_sha256=""))
+    # Legacy 24-feature models keep their existing scoring behaviour.
+    assert main.mlp_may_enforce(SimpleNamespace(feature_schema="legacy24"))
+
+
+def test_load_hashes_exact_model_bytes(synthetic_mlp_model_path):
+    detector = mlp_engine.MLPThreatDetector(str(synthetic_mlp_model_path))
+    assert detector.model_loaded
+    assert detector.model_sha256 == hashlib.sha256(Path(synthetic_mlp_model_path).read_bytes()).hexdigest()
+
+
+def test_corrupt_model_leaves_engine_on_baseline(tmp_path, monkeypatch):
+    corrupt = tmp_path / "mlp_packet14.pkl"
+    corrupt.write_bytes(b"not a pickle")
+    monkeypatch.setattr(mlp_engine, "_detector_instance", None)
+    monkeypatch.setenv("MINIFW_MLP_MODEL", str(corrupt))
+    assert main.init_mlp_detector(True) == (None, False)
+    monkeypatch.setattr(mlp_engine, "_detector_instance", None)
+    monkeypatch.setenv("MINIFW_MLP_MODEL", str(tmp_path / "missing.pkl"))
+    assert main.init_mlp_detector(True) == (None, False)
+
+
+def test_ai_score_alone_cannot_block_but_can_escalate_rule_evidence():
+    policy = Policy(str(ROOT / "config/modes/minifw_school/policy.json"))
+    student = policy.thresholds("student")
+    weights = policy.features()
+    # AI alone: at most mlp_weight (30) points, below every block threshold.
+    assert main.score_and_decide("x.example", False, False, False, 0, weights, student, mlp_score=100)[2] != "block"
+    # Rule evidence without AI stays below block; the same evidence with AI crosses it.
+    rules = dict(asn_denied=True, burst_hit=1, ip_denied=True)
+    without = main.score_and_decide("x.example", False, False, rules["asn_denied"], rules["burst_hit"], weights, student,
+                                    ip_denied=rules["ip_denied"])
+    with_ai = main.score_and_decide("x.example", False, False, rules["asn_denied"], rules["burst_hit"], weights, student,
+                                    mlp_score=100, ip_denied=rules["ip_denied"])
+    assert without[2] != "block" and with_ai[2] == "block"
+    assert any(reason.startswith("mlp_threat_score_") for reason in with_ai[1])
