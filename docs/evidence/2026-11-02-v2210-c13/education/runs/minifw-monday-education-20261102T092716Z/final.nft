table inet minifw { # handle 37
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 282 bytes 94436 comment "MiniFW-AI-Conntrack" # handle 5
		ip saddr @minifw_block_v4 counter packets 106 bytes 43560 drop comment "MiniFW-AI-Blocklist" # handle 6
	}
}
