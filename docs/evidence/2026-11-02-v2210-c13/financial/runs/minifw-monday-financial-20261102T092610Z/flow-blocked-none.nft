table inet minifw { # handle 35
	set minifw_block_v4 { # handle 1
		type ipv4_addr
		timeout 1h
		elements = { 10.10.0.20 timeout 15s expires 14s992ms }
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy accept;
		ct state new counter packets 50 bytes 3056 comment "MiniFW-AI-Conntrack" # handle 3
		ip saddr @minifw_block_v4 counter packets 6 bytes 360 drop comment "MiniFW-AI-Blocklist" # handle 4
	}
}
